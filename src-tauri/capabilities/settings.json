{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: preferences and shortcuts only. No file-system or terminal commands.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "store:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "log:default",
    "os:allow-locale",
    "allow-menu-items",
    "allow-set-shortcuts",
    "allow-remote-save-secret",
    "allow-remote-has-secret",
    "allow-remote-test"
  ]
}
