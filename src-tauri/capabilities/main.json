{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Browser windows (main and those opened with New Window). No fs/shell plugin access: all disk I/O goes through app commands.",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "dialog:default",
    "store:default",
    "window-state:default",
    "log:default",
    "os:default",
    "os:allow-hostname",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "drag:default",
    "notification:default",
    "opener:allow-open-url",
    "core:menu:default",
    "core:webview:allow-internal-toggle-devtools",
    "allow-open-dir",
    "allow-stat-path",
    "allow-complete-path",
    "allow-watch-dir",
    "allow-unwatch-dir",
    "allow-start-job",
    "allow-cancel-job",
    "allow-resolve-conflict",
    "allow-measure",
    "allow-rename-path",
    "allow-create-item",
    "allow-make-symlink",
    "allow-checksum",
    "allow-set-permissions",
    "allow-pause-job",
    "allow-find-duplicates",
    "allow-compare-folders",
    "allow-verify-checksums",
    "allow-trash-count",
    "allow-convert-image",
    "allow-is-locked",
    "allow-archive-encrypted",
    "allow-set-locked",
    "allow-pasteboard-write-files",
    "allow-pasteboard-read-files",
    "allow-apps-for-path",
    "allow-open-with",
    "allow-drag-preview",
    "allow-home-dir",
    "allow-launch-dir",
    "allow-self-test-dir",
    "allow-standard-locations",
    "allow-list-volumes",
    "allow-eject-volume",
    "allow-space-for",
    "allow-check-full-disk-access",
    "allow-open-path",
    "allow-reveal-in-finder",
    "allow-open-full-disk-access-settings",
    "allow-take-open-requests",
    "allow-open-window",
    "allow-window-start-path",
    "allow-quick-look",
    "allow-quick-look-close",
    "allow-quick-look-visible",
    "allow-preview-text",
    "allow-preview-hex",
    "allow-allow-preview",
    "allow-pty-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-close",
    "allow-search-start",
    "allow-search-cancel",
    "allow-favorite-tags",
    "allow-batch-rename",
    "allow-edit-tags",
    "allow-menu-items",
    "allow-set-shortcuts",
    "allow-set-menu-titles",
    "allow-open-settings",
    "allow-log-file",
    "allow-updates-enabled",
    "allow-newer-release",
    "allow-git-status",
    "allow-disk-usage",
    "allow-disk-usage-cancel",
    "allow-archive-list",
    "allow-archive-open-member",
    "allow-remote-set-connections",
    "allow-remote-save-secret",
    "allow-remote-has-secret",
    "allow-remote-test",
    "allow-remote-list",
    "allow-remote-create-dir",
    "allow-remote-rename",
    "allow-remote-delete",
    "allow-remote-open-member",
    "allow-remote-register-test-folder",
    "updater:default",
    "process:allow-restart"
